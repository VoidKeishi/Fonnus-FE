# Secrets & machine-specific. The glob also covers .env.bak / .env.prod / .env.local.
.env*
!.env.example

# Call artifacts must never land on a tracked path, whatever tool wrote them
# (the same backstop as the pipeline repo). The exception is the product's own
# recorded greeting, which is a shipped asset and has to be committed.
*.wav
!public/audio/*.wav
*.raw
**/events.jsonl
**/call.json

# Node / Next.js
node_modules/
.next/
out/
dist/
*.tsbuildinfo
# Regenerated by `next build` / `next dev`; Next.js ships it gitignored.
next-env.d.ts
